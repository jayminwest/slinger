#!/bin/sh
# A stand-in for Claude Code's stream mode, as far as the daemon uses it, for
# the daemon's tests (tests/process.rs). It runs in the agent's home and
# leaves its evidence there: its arguments (args.txt, one run per line), its
# environment (env.txt, and its PATH in path.txt) and each line it was sent
# (in.txt). Its store of conversations is known.txt, one id per line: a
# resume of an id not there fails, as Claude Code's does. For each line it
# names its session and answers, but for the message "mid-turn": its turn
# runs on, and takes the next message in, so the two get one answer. Its
# model reply before the nth answer says its context holds 1000n + 8 tokens.
printf '%s\n' "$*" >> args.txt
printf '%s %s\n' "$SLINGER_AGENT" "$SLINGER_SOCKET" > env.txt
printf '%s\n' "$PATH" > path.txt
id=
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) id="$2"; printf '%s\n' "$id" >> known.txt; shift ;;
    --resume)
      id="$2"; shift
      grep -qx "$id" known.txt 2>/dev/null || {
        printf 'No conversation found with session ID: %s\n' "$id" >&2; exit 1; } ;;
  esac
  shift
done
n=0
while IFS= read -r line; do
  n=$((n + 1))
  printf '%s\n' "$line" >> in.txt
  printf '{"type":"system","subtype":"init","session_id":"%s"}\n' "$id"
  case "$line" in *'"content":"mid-turn"'*) continue ;; esac
  printf '{"type":"assistant","session_id":"%s","parent_tool_use_id":null,"message":{"role":"assistant","usage":{"input_tokens":3,"cache_read_input_tokens":%s000,"output_tokens":5}}}\n' "$id" "$n"
  printf '{"type":"result","subtype":"success","session_id":"%s","result":"answer %s"}\n' "$id" "$n"
done
