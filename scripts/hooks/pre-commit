#!/usr/bin/env bash
# Runs the full check-all before every commit. If a gate is too slow for this hook,
# make the gate faster; do not skip it here. Install: git config core.hooksPath scripts/hooks
set -euo pipefail
# git exports GIT_DIR and friends to hooks; clear them so cargo and the gates see
# this checkout the normal way.
for v in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
cd "$(git rev-parse --show-toplevel)"
exec cargo xtask check-all
